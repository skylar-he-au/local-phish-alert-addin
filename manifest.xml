<?xml version="1.0" encoding="UTF-8"?>
<!-- Local Phish Alert for Outlook (MVP-PRD M3). Hosted on GitHub Pages (D14): static files only;
     no email content is sent there. Two commands on a message: open the panel (pinnable, so it
     follows the selected message on work/school accounts), or a one-click check that shows the
     verdict in the message's notification bar only (D17). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>664683df-cc9e-4af7-844c-03131690e8bf</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>CSIT998 Project 12</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Local Phish Alert"/>
  <Description DefaultValue="Checks the open email for phishing and BEC on this computer only."/>
  <IconUrl DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/skylar-he-au/local-phish-alert-addin"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="PaneButton.Label"/>
                  <Supertip>
                    <Title resid="PaneButton.Label"/>
                    <Description resid="PaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="msgReadQuickCheckButton">
                  <Label resid="QuickButton.Label"/>
                  <Supertip>
                    <Title resid="QuickButton.Label"/>
                    <Description resid="QuickButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>checkMessage</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Local Phish Alert"/>
        <bt:String id="PaneButton.Label" DefaultValue="Open panel"/>
        <bt:String id="QuickButton.Label" DefaultValue="Quick check"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="PaneButton.Tooltip" DefaultValue="Open the Local Phish Alert panel. Pin it to check every email you open."/>
        <bt:String id="QuickButton.Tooltip" DefaultValue="Check this email on this computer and show the result above the message."/>
      </bt:LongStrings>
    </Resources>
    <!-- V1_1 makes the panel pinnable (spike R5): it stays open and follows the selected message.
         Clients without V1_1 use the V1_0 definition above. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="PaneButton.Label"/>
                    <Supertip>
                      <Title resid="PaneButton.Label"/>
                      <Description resid="PaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="msgReadQuickCheckButton">
                    <Label resid="QuickButton.Label"/>
                    <Supertip>
                      <Title resid="QuickButton.Label"/>
                      <Description resid="QuickButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>checkMessage</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/taskpane.html"/>
          <bt:Url id="Commands.Url" DefaultValue="https://skylar-he-au.github.io/local-phish-alert-addin/commands.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Local Phish Alert"/>
          <bt:String id="PaneButton.Label" DefaultValue="Open panel"/>
          <bt:String id="QuickButton.Label" DefaultValue="Quick check"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="PaneButton.Tooltip" DefaultValue="Open the Local Phish Alert panel. Pin it to check every email you open."/>
          <bt:String id="QuickButton.Tooltip" DefaultValue="Check this email on this computer and show the result above the message."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
